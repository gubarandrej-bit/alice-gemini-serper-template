# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Optional (recommended): Serper API key for internet search; without it regular Gemini answers still work
SERPER_API_KEY=

# Optional: fast and cost-efficient Gemini model used by default
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional security: restrict webhook calls to your specific Yandex Dialogs skill ID
ALICE_SKILL_ID=

# Optional security: shared secret checked against ?secret=... query param or x-webhook-secret header
WEBHOOK_SECRET=
