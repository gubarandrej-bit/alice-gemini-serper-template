# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Optional (recommended): Serper API key for fast internet search + caching.
# If omitted, built-in Gemini Google Search grounding is used automatically!
SERPER_API_KEY=

# Optional: primary and automatic fallback Gemini models (on 429/5xx)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: set to "false" to disable Gemini built-in Google Search grounding when SERPER_API_KEY is absent
GEMINI_GROUNDING=true

# Optional security: restrict webhook calls to your specific Yandex Dialogs skill ID
ALICE_SKILL_ID=

# Optional security: shared secret checked against ?secret=... query param or x-webhook-secret header
WEBHOOK_SECRET=

# Optional anti-spam: max Gemini API requests per minute per user (default: 25, set 0 to disable)
RATE_LIMIT_PER_MINUTE=25

# Optional: Upstash Redis REST credentials for cross-instance storage of >4.5s background answers.
# Without these, background answers still work via Vercel waitUntil + in-memory cache!
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
